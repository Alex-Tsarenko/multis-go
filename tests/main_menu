#!/bin/bash
# ========================================
# Bash-скрипт: Система мониторинг и помощь
# Создан для быстрой работы с системой
# ========================================

declare -r RED='\033[0;31m'
declare -r GREEN='\033[0;32m'
declare -r YELLOW='\033[0;33m'
declare -r BLUE='\033[0;34m'
declare -r CYAN='\033[0;36m'
declare -r RESET='\033[0m'

echo "========================================"
echo "$GREEN${CYANBASH-Системный мониторинг и помощь$RESET}"
echo "$BLUE$CYANПожелаю, что нужно!$RESET"
echo "========================================"
echo ""

# Функция вывода сообщения с цветом
color() {
    echo -e "$1"$2
}

# Показать информацию об ОС (ОС info)
show_os_info() {
    echo "----------------------------------------"
    color $BLUE"Информация о системе:"
    echo ""
    
    echo -n "Имя пользователя: " && whoami
    echo ""
    echo -n "Путь к домашнему каталогу: " && echo "$HOME"
    echo ""
    echo -n "Дисковое пространство: " && df -h | grep -v "^tmp" | awk '{print $2, $3, $4}'
    echo ""
    echo -n "Операционная система: " && uname -r
    echo ""
    echo -n "Процессор: " && grep processor /proc/cpuinfo | wc -l
    echo ""
    echo -n "Память (RAM): " && free -m | awk '/^Mem/{printf "%d MB\n", $3+free}'
}

# Просмотр файлов в текущем катоге
show_files() {
    local dir=""
    
    if [ ! -d "$HOME" ]; then
        echo ""
        echo "Ошибка: Домашний каталог не найден!"
        return
    fi
    
    # Проверить, существует ли домашний каталог пользователя
    dir="${1:-$HOME}"
    
    if [ ! -d "$dir" ]; then
        echo ""
        color $RED"Ошибка: Каталог '$dir' не найден!"
        exit 1
    fi
    
    echo "----------------------------------------"
    color $BLUE"Файлы в '$dir':"
    ls -lh "$dir/" | grep -E '\.(sh|txt)$' || true
}

# Помощник с информацией
show_help() {
    cat <<EOF
$YELLOWИспользуйте этот скрипт как помощник для системы!$RESET
   
Список функций:
EOF
    
    echo ""
    echo "$BLUE1. show_os_info"
    color $BLUE"- Показывает информацию о системе (пользователь, каталог, память и т.д.)"
    echo ""
    echo "$BLUE2. show_files <каталог>"
    color $BLUE"- Просматривает файлы в указанном каталоге или текущем каталоге"
    echo ""
    echo "$BLUE3. help"
    color $BLUE"- Показывает эту справку"
    echo ""
}

# Главная функция меню
main_menu() {
    local choice=0
    
    while true; do
        echo ""
        echo "$CYANВыберите опцию:$RESET"
        
        show_help
        
        # Запрашиваем номер выбора
        read -p "Введите номер функции: " input
        
        case $input in
            1) show_os_info ;;
            2) 
                local file_dir="$HOME"
                if [ ! -z "$file_dir" ]; then
                    show_files "$file_dir"
                fi ;;
            3) exit 0 ;;
            *) color $YELLOW"Неверный выбор! Попробуйте еще раз.$RESET" ;;
        esac
        
        echo ""
    done
}

